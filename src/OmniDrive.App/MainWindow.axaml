<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OmniDrive.App.MainWindow"
        Title="OmniDrive" Width="1440" Height="900" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#14121B" Foreground="#F4F0FA">
  <Window.Styles>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#A49CAF"/></Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#BEB6CB"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,12"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontSize" Value="14"/></Style>
    <Style Selector="Button.nav:pointerover"><Setter Property="Background" Value="#292431"/><Setter Property="Foreground" Value="#FFFFFF"/></Style>
    <Style Selector="Button.nav.selected"><Setter Property="Background" Value="#382844"/><Setter Property="Foreground" Value="#DCA8FF"/></Style>
    <Style Selector="Button.action"><Setter Property="Background" Value="#A855F7"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Padding" Value="15,9"/><Setter Property="CornerRadius" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.ghost"><Setter Property="Background" Value="#272330"/><Setter Property="Foreground" Value="#E8E0F2"/><Setter Property="Padding" Value="11,8"/><Setter Property="CornerRadius" Value="9"/></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#201D28"/><Setter Property="BorderBrush" Value="#332D3D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/></Style>
    <Style Selector="TextBox.search"><Setter Property="Background" Value="#25212D"/><Setter Property="Foreground" Value="#F4F0FA"/><Setter Property="BorderBrush" Value="#393242"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="12,9"/></Style>
  </Window.Styles>
  <Grid ColumnDefinitions="224,*">
    <Border Grid.Column="0" Background="#1B1823" BorderBrush="#302A39" BorderThickness="0,0,1,0" Padding="16">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="4,8,0,28">
          <Border Width="38" Height="38" CornerRadius="12" Background="#A855F7"><TextBlock Text="O" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock Text="OmniDrive" FontSize="20" FontWeight="Bold"/><TextBlock Text="UNIFIED STORAGE" FontSize="9" Classes="muted"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="6">
          <TextBlock Text="ESPAÇO DE TRABALHO" Classes="muted" FontSize="10" FontWeight="Bold" Margin="10,0,0,8"/>
          <Button x:Name="OverviewNav" Classes="nav" Click="Overview_Click"><StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="▦" FontSize="17"/><TextBlock Text="Visão geral" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="CloudDriveNav" Classes="nav selected" Click="CloudDrive_Click"><StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="▤" FontSize="17"/><TextBlock Text="Drive na nuvem" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="TrashNav" Classes="nav" Click="Trash_Click"><StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="▱" FontSize="18"/><TextBlock Text="Lixeira" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
          <Button x:Name="SettingsNav" Classes="nav" Click="Settings_Click"><StackPanel Orientation="Horizontal" Spacing="13"><TextBlock Text="⚙" FontSize="17"/><TextBlock Text="Configurações" VerticalAlignment="Center"/></StackPanel></Button>
          <Border Classes="panel" Padding="12"><StackPanel Spacing="7"><TextBlock Text="PRIVACIDADE EM PRIMEIRO LUGAR" FontSize="10" FontWeight="Bold" Foreground="#D7B1FF"/><TextBlock Text="Credenciais e sessões devem permanecer protegidas no dispositivo." FontSize="11" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <TextBlock Text="OmniDrive • Prévia da interface" Classes="muted" FontSize="10" Margin="4,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Background="#191620" BorderBrush="#302A39" BorderThickness="0,0,0,1" Padding="24,16">
        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
          <StackPanel Spacing="4"><TextBlock Text="OmniDrive" FontSize="24" FontWeight="Bold"/><TextBlock Text="Gerencie arquivos de diferentes serviços em um só lugar." FontSize="12" Classes="muted"/></StackPanel>
          <TextBox Grid.Column="1" Classes="search" Width="420" Watermark="Buscar arquivos e pastas..." TextChanged="Search_TextChanged" Margin="16,0"/>
          <Border Grid.Column="2" Width="44" Height="44" Background="#33263F" CornerRadius="13" Margin="8,0,0,0" BorderBrush="#5B3C72" BorderThickness="1"><TextBlock Text="OD" Foreground="#E5C9FF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </Grid>
      </Border>
      <Grid Grid.Row="1" ColumnDefinitions="*,300">
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="24,22,16,16">
          <Grid Grid.Row="0" ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="7">
            <StackPanel Spacing="4"><TextBlock x:Name="AreaTitle" Text="Drive na nuvem" FontSize="25" FontWeight="Bold"/><TextBlock Text="Arquivos e pastas dos serviços conectados." Classes="muted" FontSize="12"/></StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Click="Back_Click" IsEnabled="False" x:Name="BackButton" Content="← Voltar"/>
                <Border Background="#25212D" CornerRadius="9" Padding="12,8"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="▤" Foreground="#C084FC"/><TextBlock Text="Todos os serviços" FontSize="12"/><TextBlock Text="›" Classes="muted"/><TextBlock x:Name="BreadcrumbCurrent" Text="Raiz" FontSize="12" Foreground="#E6C7FF"/></StackPanel></Border>
                <TextBlock x:Name="SelectionCount" Text="" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" HorizontalAlignment="Right" Classes="action" Click="New_Click" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="＋" FontSize="17"/><TextBlock Text="Novo"/></StackPanel></Button>
            </Grid>
          </Grid>
          <Border Grid.Row="1" Classes="panel" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Border BorderBrush="#332D3D" BorderThickness="0,0,0,1" Padding="14,12">
                <Grid ColumnDefinitions="34,*,105,130,26" ColumnSpacing="8">
                  <CheckBox x:Name="SelectAllCheckBox" VerticalAlignment="Center" IsEnabled="False"/>
                  <TextBlock Grid.Column="1" Text="Nome" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Tamanho" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="Modificado" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="" />
                </Grid>
              </Border>
              <Grid Grid.Row="1" x:Name="EmptyFilesState" Margin="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="10">
                  <Border Width="58" Height="58" CornerRadius="18" Background="#332641"><TextBlock Text="▤" FontSize="29" Foreground="#D6A8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <TextBlock Text="Nenhum arquivo disponível" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Conecte um serviço para carregar a lista. Os arquivos e seus metadados serão exibidos aqui quando o provedor fornecer essas informações." Classes="muted" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
        <Border Grid.Column="1" x:Name="DetailsPanel" Background="#1B1823" BorderBrush="#302A39" BorderThickness="1,0,0,0" Padding="18">
          <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Detalhes" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Metadados do item selecionado" Classes="muted" FontSize="11"/></StackPanel><Button Grid.Column="1" Classes="ghost" Content="›" Click="ToggleDetails_Click" ToolTip.Tip="Recolher painel"/></Grid>
            <Border Grid.Row="1" Background="#292431" CornerRadius="12" Padding="14" Margin="0,18,0,16">
              <StackPanel Spacing="8"><Border Width="42" Height="42" CornerRadius="12" Background="#382844" HorizontalAlignment="Left"><TextBlock Text="?" FontSize="22" Foreground="#D6A8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Nenhum item selecionado" FontWeight="SemiBold"/><TextBlock Text="Selecione um arquivo para ver os detalhes fornecidos pelo serviço." Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <ScrollViewer Grid.Row="2">
              <StackPanel Spacing="14">
                <TextBlock Text="INFORMAÇÕES" Classes="muted" FontSize="10" FontWeight="Bold"/>
                <StackPanel Spacing="4"><TextBlock Text="Nome" Classes="muted" FontSize="11"/><TextBlock Text="Não disponível" FontSize="12"/></StackPanel>
                <StackPanel Spacing="4"><TextBlock Text="Tamanho" Classes="muted" FontSize="11"/><TextBlock Text="Não disponível" FontSize="12"/></StackPanel>
                <StackPanel Spacing="4"><TextBlock Text="Tipo / extensão" Classes="muted" FontSize="11"/><TextBlock Text="Não disponível" FontSize="12"/></StackPanel>
                <StackPanel Spacing="4"><TextBlock Text="Data de modificação" Classes="muted" FontSize="11"/><TextBlock Text="Não fornecida pelo serviço" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                <Border Height="1" Background="#342D3E"/>
                <TextBlock Text="ORIGEM" Classes="muted" FontSize="10" FontWeight="Bold"/>
                <StackPanel Spacing="4"><TextBlock Text="Serviço" Classes="muted" FontSize="11"/><TextBlock Text="Não disponível" FontSize="12"/></StackPanel>
                <StackPanel Spacing="4"><TextBlock Text="Conta / credencial" Classes="muted" FontSize="11"/><TextBlock Text="Não conectado" FontSize="12"/></StackPanel>
                <StackPanel Spacing="4"><TextBlock Text="Pasta" Classes="muted" FontSize="11"/><TextBlock Text="Não disponível" FontSize="12"/></StackPanel>
                <Border Height="1" Background="#342D3E"/>
                <TextBlock Text="INTEGRIDADE" Classes="muted" FontSize="10" FontWeight="Bold"/>
                <StackPanel Spacing="4"><TextBlock Text="Partes do arquivo" Classes="muted" FontSize="11"/><TextBlock Text="Não aplicável ou desconhecido" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Spacing="4"><TextBlock Text="Verificação" Classes="muted" FontSize="11"/><TextBlock Text="Não verificada" FontSize="12"/></StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="2" Background="#191620" BorderBrush="#302A39" BorderThickness="0,1,0,0" Padding="20,9">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="7" Height="7" Fill="#E5A94D" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Nenhum serviço conectado" Classes="muted" FontSize="11" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Column="1" Text="Fila de transferências: 0" Classes="muted" FontSize="11" VerticalAlignment="Center"/></Grid>
      </Border>
    </Grid>
  </Grid>
</Window>