    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <PackageReference Include="WTelegramClient" Version="4.4.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <ProjectReference Include="../OmniDrive.Application/OmniDrive.Application.csproj" />
    <ProjectReference Include="../OmniDrive.Core/OmniDrive.Core.csproj" />
  </ItemGroup>
</Project>
